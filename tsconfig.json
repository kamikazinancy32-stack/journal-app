{
  "compilerOptions": {
    /* Output: compile src/*.ts into dist/*.js that the browser loads directly */
    "target": "es2020",
    "module": "es2020",
    "rootDir": "./src",
    "outDir": "./dist",
    "lib": ["ES2020", "DOM"],
    "types": [],
    "skipLibCheck": true,

    /* Type checking */
    "strict": true,

    /* Module resolution: lets `./storage.js` imports find `storage.ts` */
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true
  },
  "include": ["src"]
}
